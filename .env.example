NEXT_PUBLIC_SITE_URL=http://localhost:3289

# 選填。沒有這些時，加入日曆會用 ICS 訂閱／Google 範本連結，不會寫入用戶日曆。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3289/api/google/callback

# 簽署 Cookie／商戶 session。生產環境請設定。
SESSION_SECRET=

# 活動 CMS：/admin
ADMIN_PASSWORD=

# 商戶 PIN。格式 restaurantId:pin,restaurantId:pin。未設定時試用 PIN 為 4821。
MERCHANT_PINS=
MERCHANT_DEFAULT_PIN=4821

# 入座 webhook HMAC（header: x-webhook-secret）
WEBHOOK_SECRET=

# Agent LLM（無則用關鍵字搜尋）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API。無則只用 wa.me 連結。
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# 步行分鐘。無則用座標估算。
GOOGLE_MAPS_API_KEY=

# SQLite 路徑。未設則用 ./data/heungtime.sqlite（Vercel 為 /tmp）。
DATABASE_PATH=
