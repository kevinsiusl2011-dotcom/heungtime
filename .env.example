NEXT_PUBLIC_SITE_URL=http://localhost:3289

# 選填。沒有這些時，加入日曆會用 ICS 訂閱／Google 範本連結，不會寫入用戶日曆。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3289/api/google/callback

# 簽署 Cookie／商戶 session。生產環境必填，否則受保護路由無法啟動。
SESSION_SECRET=

# 活動 CMS：/admin
ADMIN_PASSWORD=

# 商戶 PIN。格式 restaurantId:pin,restaurantId:pin。生產環境未設定則無法登入。
MERCHANT_PINS=
MERCHANT_DEFAULT_PIN=

# 入座 webhook HMAC（header: x-webhook-secret）
WEBHOOK_SECRET=

# Agent LLM（無則用關鍵字搜尋）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ⚠️ WHATSAPP SAFETY LOCK（保留零成本 wa.me 方法為預設）
# ============================================================
# Agentic AI 預設只用 wa.me（用戶自己開 WhatsApp 手動發，完全零成本）。
# 就算你填好下面 WHATSAPP_TOKEN + PHONE_NUMBER_ID，
# 一定要人手 set 下面 WHATSAPP_CLOUD_SEND_ENABLED=true 先會自動 send 俾餐廳。
# 呢個 default-off 模式防止 deploy 時填錯 env 就意外出錢。
# WHATSAPP_CLOUD_SEND_ENABLED=true

# WhatsApp Cloud API（自動 send 訂座俾餐廳；有成本，需小心用量）。無則只用 wa.me 連結。
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# 步行分鐘。無則用座標估算。
GOOGLE_MAPS_API_KEY=

# SQLite 路徑。未設則用 ./data/heungtime.sqlite。Vercel 無狀態環境資料會在 /tmp 遺失，生產請用持久磁碟或外置 DB。
DATABASE_PATH=
